<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#050607">
  <meta name="description" content="Explore Luxero Competitions, Luxero Agro and our official community. Everyone deserves a fair chance at something extraordinary.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="LUXERO — A fair chance at something extraordinary.">
  <meta property="og:description" content="Luxero Competitions, Luxero Agro and our official community. All our links in one place.">
  <meta property="og:url" content="https://luxero-links.ncsbogdan.chatgpt.site">
  <meta property="og:image" content="https://luxero-links.ncsbogdan.chatgpt.site/assets/share.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href="https://luxero-links.ncsbogdan.chatgpt.site/">
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
  <link rel="stylesheet" href="assets/montserrat.css">
  <link rel="stylesheet" href="assets/cormorant.css">
  <link rel="stylesheet" href="theme.css">
  <link rel="stylesheet" href="style.css">
  <title>LUXERO — Official Links</title>
  <script src="main.js" defer></script>
</head>
<body>
  <svg class="symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <symbol id="share" viewBox="0 0 24 24"><path d="M12 16V3m-5 5 5-5 5 5M5 13v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/></symbol>
    <symbol id="instagram" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01" stroke-width="3"/></symbol>
    <symbol id="tiktok" viewBox="0 0 24 24"><path d="M15 3v12.5a5 5 0 1 1-4-4.9M15 3c.4 3.4 2.2 5.2 6 5.5v4c-2.4-.1-4.2-.8-6-2.3"/></symbol>
    <symbol id="whatsapp" viewBox="0 0 24 24"><path d="M21 11.6a9 9 0 0 1-13.3 8L3 21l1.4-4.6A9 9 0 1 1 21 11.6Z"/><path d="m8 7 1.5-.3 1.1 2.6-1.1 1.1a8 8 0 0 0 3.8 3.8l1.1-1.1 2.6 1.1-.3 1.5c-.2 1-1.1 1.5-2 1.2a12 12 0 0 1-8-8c-.3-.9.2-1.8 1.3-1.9Z" stroke-width="1.35"/></symbol>
    <symbol id="telegram" viewBox="0 0 24 24"><path d="m3 10 18-7-4 18-6-7-8-4Z"/><path d="m11 14 5-6m-5 6-1 5 3-3"/></symbol>
    <symbol id="youtube" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3Z"/></symbol>
    <symbol id="check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
  </svg>

  <a class="skip-link" href="#explore">Skip to links</a>
  <div class="ambient" aria-hidden="true"></div>
  <div class="page-shell">
    <header class="masthead">
      <a class="wordmark" href="https://luxero.win/" target="_blank" rel="noopener noreferrer" aria-label="Luxero — official website">LUXERO</a>
      <div class="header-actions">
        <button class="share-button" type="button" id="share-button" aria-label="Share this page" title="Share this page">
          <svg class="icon" aria-hidden="true"><use href="#share"/></svg>
        </button>
      </div>
    </header>

    <main>
      <section class="intro" aria-labelledby="page-title">
        <h1 id="page-title"><span class="motto-white">Everyone deserves <em>a fair chance.</em></span>
          <span class="motto-gold">At something extraordinary.</span></h1>
      </section>

      <section id="explore" class="destinations" aria-label="Luxero platforms">
        <a class="destination destination-competitions" href="https://luxero.win/" target="_blank" rel="noopener noreferrer">
          <div class="destination-photo"><img src="assets/cupra.webp" width="1400" height="788" alt="Cupra Formentor from Luxero Competitions" fetchpriority="high"></div>
          <div class="photo-shade" aria-hidden="true"></div>
          <div class="card-top"><span class="card-kicker">EXPLORE THE PLATFORM</span></div>
          <div class="card-bottom">
            <div class="card-copy"><h2>Luxero <span>Competitions</span></h2><p class="destination-description">Cars · Tech · Cash prizes</p></div>
          </div>
        </a>
        <a class="destination destination-agro" href="https://agro.luxero.win/" target="_blank" rel="noopener noreferrer">
          <div class="destination-photo"><img src="assets/agro.webp" width="1400" height="788" alt="John Deere from Luxero Agro" fetchpriority="high"></div>
          <div class="photo-shade" aria-hidden="true"></div>
          <div class="card-top"><span class="card-kicker">EXPLORE THE PLATFORM</span></div>
          <div class="card-bottom">
            <div class="card-copy"><h2>Luxero <span>Agro</span></h2><p class="destination-description">Machinery · Equipment · Tools</p></div>
          </div>
        </a>
      </section>

      <section class="community" aria-labelledby="community-title">
        <div class="section-heading"><h2 id="community-title">Follow us !</h2></div>
        <div class="social-grid">
          <a class="social-link" href="https://t.me/luxero_competitions" target="_blank" rel="noopener noreferrer">
            <span class="social-title"><svg class="icon" aria-hidden="true"><use href="#telegram"/></svg><span class="social-name">Telegram</span></span>
            <span class="social-description">join our group for news and discounts</span>
          </a>
          <a class="social-link" href="https://www.tiktok.com/@luxero.win" target="_blank" rel="noopener noreferrer">
            <span class="social-title"><svg class="icon" aria-hidden="true"><use href="#tiktok"/></svg><span class="social-name">TikTok</span></span>
            <span class="social-description">The story, frame by frame</span>
          </a>
          <a class="social-link" href="https://www.instagram.com/win.luxero/" target="_blank" rel="noopener noreferrer">
            <span class="social-title"><svg class="icon" aria-hidden="true"><use href="#instagram"/></svg><span class="social-name">Instagram</span></span>
            <span class="social-description">A closer look at Luxero</span>
          </a>
          <a class="social-link" href="https://www.youtube.com/@Luxero_win" target="_blank" rel="noopener noreferrer">
            <span class="social-title"><svg class="icon" aria-hidden="true"><use href="#youtube"/></svg><span class="social-name">YouTube</span></span>
            <span class="social-description">Watch on YouTube</span>
          </a>
          <a class="social-link" href="https://chat.whatsapp.com/GPcQAlYiSwNGL2NcGZY0Bg" target="_blank" rel="noopener noreferrer">
            <span class="social-title"><svg class="icon" aria-hidden="true"><use href="#whatsapp"/></svg><span class="social-name">WhatsApp</span></span>
            <span class="social-description">Join the Luxero group</span>
          </a>
        </div>
      </section>

    </main>

    <footer class="footer">
      <div class="footer-main"><span>© 2026 LUXERO COMPETITIONS LTD</span><span class="official-label"><span class="diamond" aria-hidden="true"></span><span>OFFICIAL LINKS</span></span></div>
      <div class="footer-legal"><span>18+ · Participate responsibly.</span><a href="https://luxero.win/en/terms" target="_blank" rel="noopener noreferrer">Terms &amp; conditions</a><a href="https://luxero.win/en/free-postal-entry" target="_blank" rel="noopener noreferrer">Free postal entry</a></div>
    </footer>
  </div>

  <div class="toast" id="share-toast" role="status" aria-live="polite"><svg class="icon" aria-hidden="true"><use href="#check"/></svg><span></span></div>
  <dialog class="copy-dialog" id="copy-dialog"><form method="dialog"><div class="dialog-heading"><h2>Share Luxero</h2><button class="dialog-close" aria-label="Close">×</button></div><p>Copy the link below:</p><input id="copy-url" readonly aria-label="Link"><button class="dialog-done">Done</button></form></dialog>
</body>
</html>
