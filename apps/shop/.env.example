# apps/shop — Environment Template
# Copy to .env.local and fill in secrets:
#   cp .env.example .env.local

PORT=3444
NEXT_PUBLIC_SHOP_URL=http://localhost:3444
APP_URL=http://localhost:3444

# ===== Auth =====
BETTER_AUTH_SECRET=
CROSS_SUBDOMAIN_COOKIES=false
RATE_LIMIT_AUTH=0

# ===== Database =====
DATABASE_URL=

# ===== Payment =====
ENABLE_LOCAL_PAYMENT_METHOD=true
# Stripe
# STRIPE_PUBLISHABLE_KEY           pk_test_xxx
# STRIPE_SECRET_KEY                sk_test_xxx
# STRIPE_WEBHOOK_SECRET            whsec_xxx
# STRIPE_ENVIRONMENT               test
# STRIPE_CURRENCY                  GBP
# STRIPE_HTTP_TIMEOUT_MS           15000
# STRIPE_HTTP_RETRIES              2
# STRIPE_TEST_SECRET_KEY           sk_test_xxx
# STRIPE_TEST_PUBLISHABLE_KEY      pk_test_xxx
# STRIPE_TEST_WEBHOOK_SECRET       whsec_test_xxx
# STRIPE_LIVE_SECRET_KEY           sk_live_xxx
# STRIPE_LIVE_PUBLISHABLE_KEY      pk_live_xxx
# STRIPE_LIVE_WEBHOOK_SECRET       whsec_live_xxx

# ===== Email =====
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SEND_EMAIL=true

# ===== Umami Analytics =====
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ===== Turnstile CAPTCHA =====
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
