# =============================================================================
# apps/client — Environment Template
# Copy to .env and fill in secrets:
#   cp .env.example .env
# =============================================================================
# NOTE: Vite/Vike uses PUBLIC_ENV__ prefix for client-exposed vars.
# Server-side-only vars (e.g. TURNSTILE_SECRET_KEY) have no prefix.
# Secret generation:
#   BETTER_AUTH_SECRET  openssl rand -hex 32

# --- Generated secrets (unique per developer) ---
BETTER_AUTH_SECRET=

# --- App URLs ---
PUBLIC_ENV__APP_URL=http://localhost:3555
PUBLIC_ENV__ADMIN_URL=http://localhost:3222
LUXERO_API_BASE_URL=http://localhost:3555

# --- Auth ---
CROSS_SUBDOMAIN_COOKIES=false
RATE_LIMIT_AUTH=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# --- Payment ---
PUBLIC_ENV__PAYMENT_BYPASS=true
PUBLIC_ENV__PAYMENT_DEBUG=true
# Stripe (browser-exposed key uses PUBLIC_ENV__ prefix)
PUBLIC_ENV__STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY                sk_test_xxx
# STRIPE_WEBHOOK_SECRET            whsec_xxx
# STRIPE_ENVIRONMENT               test
# STRIPE_CURRENCY                  GBP
# STRIPE_HTTP_TIMEOUT_MS           15000
# STRIPE_HTTP_RETRIES              2
# STRIPE_TEST_SECRET_KEY           sk_test_xxx
# STRIPE_TEST_PUBLISHABLE_KEY      pk_test_xxx
# STRIPE_TEST_WEBHOOK_SECRET       whsec_test_xxx
# STRIPE_LIVE_SECRET_KEY           sk_live_xxx
# STRIPE_LIVE_PUBLISHABLE_KEY      pk_live_xxx
# STRIPE_LIVE_WEBHOOK_SECRET       whsec_live_xxx

# --- Database ---
DATABASE_URL=mongodb://root:luxero_dev_password@localhost:27017/luxero?authSource=admin

# --- Email (Mailpit) ---
SEND_EMAIL=true
SMTP_ENABLED=true
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_FROM=noreply@luxero.local
EMAIL_SECURE=false

# --- S3 (MinIO) ---
S3_ENDPOINT=http://localhost:9011
S3_ACCESS_KEY=luxero_dev_access_key
S3_SECRET_KEY=luxero_dev_secret_key
S3_BUCKET=luxero-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- Sentry (optional) ---
PUBLIC_ENV__SENTRY_DSN_WEB=
PUBLIC_ENV__SENTRY_ENVIRONMENT=development
PUBLIC_ENV__SENTRY_RELEASE=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Push Notifications (VAPID) ---
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Cloudflare Turnstile CAPTCHA ---
# Use test key 1x00000000000000000000AA for local dev without Cloudflare
PUBLIC_ENV__TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Umami Analytics ---
VITE_UMAMI_WEBSITE_ID=

# --- Runtime ---
FRAMEWORK=vike
LOG_ERROR_STACKS=true
LOG_DB_CONNECT_DEBUG=true
ENABLE_LOCAL_PAYMENT_METHOD=true
