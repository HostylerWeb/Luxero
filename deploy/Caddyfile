# Production (luxero.win)
luxero.win, www.luxero.win {
	reverse_proxy client:3000
}

agro.luxero.win {
	reverse_proxy client-agro:3000
}

admin.luxero.win, www.admin.luxero.win {
	reverse_proxy admin:3000
}

admin.agro.luxero.win {
	reverse_proxy admin-agro:3000
}

shop.luxero.win, www.shop.luxero.win {
	reverse_proxy shop:3000
}

link.luxero.win {
	reverse_proxy web-lander:3000
}

assets.luxero.win {
	reverse_proxy minio:9000
}

# Staging hostnames → same Hostinger stack (DNS must point here, not Hetzner)
staging.luxero.win, www.staging.luxero.win, app.staging.luxero.win {
	reverse_proxy client:3000
}

admin.staging.luxero.win {
	reverse_proxy admin:3000
}

shop.staging.luxero.win {
	reverse_proxy shop:3000
}

assets.staging.luxero.win {
	reverse_proxy minio:9000
}

agro.staging.luxero.win {
	reverse_proxy client-agro:3000
}

admin.agro.staging.luxero.win {
	reverse_proxy admin-agro:3000
}

