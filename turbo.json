{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "1",
  "globalEnv": ["NODE_ENV", "TURBO_FORCE", "VITE_APP_VERSION", "VITE_API_URL"],
  "globalDependencies": ["scripts/devservers.sh", "devservers.yml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": [],
      "cache": false
    },
    "format": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
